# Platform
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Session cookie (HttpOnly). Empty domain on localhost so all ports share it.
# Production example: .example.com
AUTH_COOKIE_NAME=ra_session
AUTH_COOKIE_DOMAIN=
AUTH_OTP_PEPPER=dev-otp-pepper-change-me
AUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Optional: first OTP login for this phone receives isPlatformAdmin
AUTH_BOOTSTRAP_PLATFORM_ADMIN_PHONE=

# Apps
DASHBOARD_URL=http://localhost:3000
BOOKING_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# Database (empty = in-memory identity; no Postgres required to boot the API)
DATABASE_URL=postgresql://reservation:reservation@localhost:5432/reservation
