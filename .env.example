# Platform
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000

# Auth / SSO
AUTH_PORT=4001
AUTH_URL=http://localhost:4001
AUTH_COOKIE_NAME=ra_session
AUTH_REFRESH_COOKIE_NAME=ra_refresh
# Empty on localhost so all ports share the host cookie.
# Production example: .example.com
AUTH_COOKIE_DOMAIN=
AUTH_OTP_PEPPER=dev-otp-pepper-change-me
AUTH_COOKIE_SIGNING_SECRET=dev-cookie-signing-change-me
AUTH_INTERNAL_SECRET=dev-internal-secret-change-me
AUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Optional: first OTP login for this phone receives SUPER_ADMIN
AUTH_BOOTSTRAP_SUPER_ADMIN_PHONE=

# Apps
DASHBOARD_URL=http://localhost:3000
BOOKING_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# Database (persistence is not configured yet)
DATABASE_URL=
